<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "EvalRails - AI Model Evaluation Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="A modern side-by-side AI Model Evaluation & Comparison Studio built with Ruby on Rails 8.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar" id="app-navbar">
      <%= link_to root_path, class: "nav-brand", id: "nav-brand-logo" do %>
        <span class="brand-badge">Rails 8</span> EvalRails
      <% end %>

      <ul class="nav-links">
        <li><%= link_to "Evaluation Arena", prompts_path, class: "nav-link #{'active' if current_page?(prompts_path) || current_page?(root_path)}", id: "nav-arena" %></li>
        <li><%= link_to "New Prompt", new_prompt_path, class: "nav-link #{'active' if current_page?(new_prompt_path)}", id: "nav-new-prompt" %></li>
        <li><%= link_to "Leaderboard & Analytics", dashboard_path, class: "nav-link #{'active' if current_page?(dashboard_path)}", id: "nav-dashboard" %></li>
        <li><%= link_to "Export JSON API", api_evaluations_path, class: "nav-link", id: "nav-api", target: "_blank" %></li>
      </ul>

      <div>
        <%= link_to "New Evaluation", new_prompt_path, class: "btn-primary", id: "btn-header-eval" %>
      </div>
    </nav>

    <main class="main-container">
      <% if flash[:notice].present? %>
        <div style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #34d399; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;" id="flash-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div style="background: rgba(244, 63, 94, 0.2); border: 1px solid #f43f5e; color: #fb7185; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;" id="flash-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer" id="app-footer">
      <p>EvalRails &bull; AI Model Evaluation & Comparison Studio &bull; Built with Ruby on Rails 8</p>
    </footer>
  </body>
</html>
